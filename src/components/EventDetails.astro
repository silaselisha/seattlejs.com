---
import type { SJSEvent } from '@/data/types'
import { formatEventTime } from '@/utils/event'

interface Props {
  event: Pick<SJSEvent, 'date' | 'startTime' | 'endTime' | 'location' | 'link'>
  showRsvp?: boolean
}

const { event, showRsvp = false } = Astro.props
const { location, link } = event
const time = formatEventTime(event)
---

<ul class="event-details">
  <li>
    📆{' '}
    {
      new Date(event.date).toLocaleDateString(undefined, {
        weekday: 'long',
        month: 'long',
        day: 'numeric',
      })
    }
  </li>
  {time && <li>⏰ {time}</li>}
  {
    location && (
      <li>
        📍{' '}
        {location.mapUrl ? (
          <a target="_blank" href={location.mapUrl}>
            {location.name}
          </a>
        ) : (
          location.name
        )}
        {location.address && `(${location.address})`}
      </li>
    )
  }
  {
    showRsvp && (
      <li>
        🎟 <a href={link}>RSVP</a>
      </li>
    )
  }
</ul>
